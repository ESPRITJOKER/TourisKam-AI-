# =========================================================
# TourisCam AI — Environment variables (TEMPLATE)
# Copy to .env and fill in. NEVER commit the real .env.
# =========================================================

# --- Supabase ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Public anon / publishable key (safe for client use WITH RLS; used by dashboard)
SUPABASE_ANON_KEY=
# Service role key — SERVER/n8n ONLY. Never expose to any frontend. (Optional:
# the Python scripts use the direct Postgres connection below, not this key.)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — used by rag/*.py and scripts/apply_sql.py.
# Option A: discrete parts (recommended; avoids URL-encoding issues with
# special characters like % or * in the password).
SUPABASE_DB_HOST=db.xxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Option B (alternative): a full DSN. If set, it overrides the discrete parts.
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# --- Google Gemini (LLM + embeddings + audio transcription) ---
GEMINI_API_KEY=
# Key from a DIFFERENT Google project, used only by bulk jobs (rag/embed_web.py,
# rag/eval_retrieval.py). Free-tier embedding quota is 1,000/day per project and
# counts every chunk, so bulk jobs must not drain the live bot's key.
GEMINI_INGEST_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Twilio WhatsApp (Sandbox for the demo) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender, format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- n8n ---
# Base URL of your n8n Cloud instance
N8N_BASE_URL=
# Optional shared secret to validate inbound webhooks
N8N_WEBHOOK_SECRET=

# --- Dashboard (Streamlit) ---
# Simple gate for the institutional dashboard (see dashboard/README)
DASHBOARD_PASSWORD=

# --- App config ---
# Salt used to hash WhatsApp numbers into anonymous session ids (privacy)
SESSION_HASH_SALT=change-me-to-a-long-random-string
